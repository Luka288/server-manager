{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@game-server/server-manager": [
        "./libs/server/server-manager/src/index.ts"
      ],
      "@game-server/command-builder": [
        "./libs/server/command-builder/src/index.ts"
      ],
      "@game-server/database": ["./libs/server/database/src/index.ts"],
      "@game-server/dashboard-data-access": [
        "./libs/client/dashboard/data-access/src/index.ts"
      ],
      "@game-server/dashboard/feature": [
        "./libs/client/dashboard/feature/src/index.ts"
      ],
      "@game-server/sidepanel/feature": [
        "./libs/client/sidepanel/feature/src/index.ts"
      ],
      "@game-server/sidepanel/data-access": [
        "./libs/client/sidepanel/data-access/src/index.ts"
      ],
      "@game-server/client/sidepanel/types": [
        "./libs/client/sidepanel/types/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
