{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@game-server/server-manager": ["./libs/server-manager/src/index.ts"],
      "@game-server/command-builder": ["./libs/command-builder/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
